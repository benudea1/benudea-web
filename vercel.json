{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/enlaces",
      "destination": "/enlaces.html"
    },
    {
      "source": "/blog",
      "destination": "/guia-etiquetas-suplementos.html"
    }
  ],
  "redirects": [
    {
      "source": "/link",
      "destination": "/enlaces",
      "permanent": false
    }
  ]
}
